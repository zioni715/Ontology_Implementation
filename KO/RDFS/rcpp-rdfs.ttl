# RCPP RDFS ontology — submission bundle
# Source modules: schema.ttl, classes.ttl, properties.ttl, code-lists.ttl
# The source modules remain authoritative for modular maintenance.

# -----------------------------------------------------------------------------
# schema.ttl
# -----------------------------------------------------------------------------
@prefix rcpp: <https://zioni715.github.io/ontology/rcpp#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://zioni715.github.io/ontology/rcpp> a rdfs:Resource ;
  rdfs:label "RCPP 단일 온톨로지"@ko ;
  rdfs:comment "철근콘크리트 공종의 공사기성부분내역서 작성에 필요한 비용 관련 서류의 항목, 수량, 단가, 금액 및 서류 간 정보전달·산정·집계 관계를 표현한다."@ko ;
  dcterms:hasVersion "1.0.0" .

# -----------------------------------------------------------------------------
# classes.ttl
# -----------------------------------------------------------------------------
@prefix rcpp: <https://zioni715.github.io/ontology/rcpp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# 업무 맥락
rcpp:ProgressPaymentRound a rdfs:Class ; rdfs:label "기성회차"@ko ; rdfs:comment "기성 산정과 청구의 시간 단위"@ko .

# 사용 서류의 폐쇄된 범위
rcpp:ProgressDocument a rdfs:Class ; rdfs:label "기성서류"@ko ; rdfs:comment "철근콘크리트 기성금액 산정에 직접 사용하는 서류의 최상위 클래스"@ko .
rcpp:OutputDocument a rdfs:Class ; rdfs:subClassOf rcpp:ProgressDocument ; rdfs:label "산출서류"@ko ; rdfs:comment "근거서류의 정보를 사용해 기성금액 산정 결과를 제시하는 서류"@ko .
rcpp:EvidenceDocument a rdfs:Class ; rdfs:subClassOf rcpp:ProgressDocument ; rdfs:label "근거서류"@ko ; rdfs:comment "기성금액 산정에 필요한 수량·단가·금액의 근거를 제공하는 서류"@ko .
rcpp:ProgressPaymentStatement a rdfs:Class ; rdfs:subClassOf rcpp:OutputDocument ; rdfs:label "공사기성부분내역서"@ko ; rdfs:comment "회차별 기성수량과 기성금액을 산정해 제시하는 유일한 산출서류"@ko .
rcpp:ContractStatement a rdfs:Class ; rdfs:subClassOf rcpp:EvidenceDocument ; rdfs:label "계약내역서"@ko ; rdfs:comment "확정된 계약수량·계약단가·계약금액을 제공하는 근거서류"@ko .
rcpp:CostCalculationStatement a rdfs:Class ; rdfs:subClassOf rcpp:EvidenceDocument ; rdfs:label "원가계산서"@ko ; rdfs:comment "비용항목의 원가 구성과 산정금액을 제공하는 근거서류"@ko .
rcpp:WorkCategorySummaryStatement a rdfs:Class ; rdfs:subClassOf rcpp:EvidenceDocument ; rdfs:label "공종별집계표"@ko ; rdfs:comment "공종별 상세 비용을 합산해 제시하는 근거서류"@ko .
rcpp:WorkCategoryDetailStatement a rdfs:Class ; rdfs:subClassOf rcpp:EvidenceDocument ; rdfs:label "공종별내역서"@ko ; rdfs:comment "공종별 비용항목의 수량·단가·금액을 제시하는 근거서류"@ko .
rcpp:QuantityCalculationSheet a rdfs:Class ; rdfs:subClassOf rcpp:EvidenceDocument ; rdfs:label "수량산출서"@ko ; rdfs:comment "계약수량의 산출 근거를 제공하는 근거서류"@ko .

# 서류 항목
rcpp:DocumentItem a rdfs:Class ; rdfs:label "기성서류항목"@ko ; rdfs:comment "기성서류에 포함되는 비용정보의 의미 단위"@ko .
rcpp:DetailItem a rdfs:Class ; rdfs:subClassOf rcpp:DocumentItem ; rdfs:label "상세비용항목"@ko ; rdfs:comment "집계 전 개별 비용항목"@ko .
rcpp:CalculatedQuantityItem a rdfs:Class ; rdfs:subClassOf rcpp:DetailItem ; rdfs:label "수량산출항목"@ko ; rdfs:comment "수량산출서에서 계약수량의 근거가 되는 산출수량 항목"@ko .
rcpp:ContractItem a rdfs:Class ; rdfs:subClassOf rcpp:DetailItem ; rdfs:label "계약항목"@ko ; rdfs:comment "계약수량·계약단가·계약금액을 제공하는 계약내역서 항목"@ko .
rcpp:CostCalculationItem a rdfs:Class ; rdfs:subClassOf rcpp:DetailItem ; rdfs:label "원가계산항목"@ko ; rdfs:comment "원가계산서에서 비용 산정 근거를 제공하는 항목"@ko .
rcpp:WorkCategoryDetailItem a rdfs:Class ; rdfs:subClassOf rcpp:DetailItem ; rdfs:label "공종별내역항목"@ko ; rdfs:comment "공종별내역서에 수량·단가·금액을 나타내는 항목"@ko .
rcpp:SummaryItem a rdfs:Class ; rdfs:subClassOf rcpp:DocumentItem ; rdfs:label "집계항목"@ko ; rdfs:comment "계약 또는 기성 상세항목의 금액을 동일 공종별로 합산한 항목"@ko .
rcpp:ContractSummaryItem a rdfs:Class ; rdfs:subClassOf rcpp:SummaryItem ; rdfs:label "계약집계항목"@ko ; rdfs:comment "공종별내역항목의 계약금액을 공종별로 합산한 공종별집계표 항목"@ko .
rcpp:ProgressPaymentSummaryItem a rdfs:Class ; rdfs:subClassOf rcpp:SummaryItem ; rdfs:label "기성집계항목"@ko ; rdfs:comment "기성금액항목의 금회금액을 공종별로 합산한 공사기성부분내역서 항목"@ko .
rcpp:ProgressPaymentItem a rdfs:Class ; rdfs:subClassOf rcpp:DetailItem ; rdfs:label "기성내역항목"@ko ; rdfs:comment "공사기성부분내역서에서 전회·금회·누계·잔여 수량과 금액을 산정하는 항목"@ko .

# 철근콘크리트 공종 범위
rcpp:CostItem a rdfs:Class ; rdfs:label "비용항목"@ko ; rdfs:comment "서류별 항목이 공통으로 나타내는 표준 비용 대상"@ko .
rcpp:WorkCategory a rdfs:Class ; rdfs:label "공종"@ko ; rdfs:comment "철근콘크리트공사와 그 하위 네 공종을 표현하는 통제 분류"@ko .
rcpp:RebarCostItem a rdfs:Class ; rdfs:subClassOf rcpp:CostItem ; rdfs:label "철근 비용항목"@ko ; rdfs:comment "철근 재료 또는 가공·조립 단가를 구분하는 비용항목"@ko .
rcpp:RebarMaterialCostItem a rdfs:Class ; rdfs:subClassOf rcpp:RebarCostItem ; rdfs:label "철근 재료비항목"@ko ; rdfs:comment "강종과 지름으로 구분하는 철근 재료 단가 항목"@ko .
rcpp:RebarFabricationAssemblyCostItem a rdfs:Class ; rdfs:subClassOf rcpp:RebarCostItem ; rdfs:label "철근 가공·조립비항목"@ko ; rdfs:comment "가공·조립 유형과 가공 장소로 구분하는 철근 시공 단가 항목"@ko .
rcpp:ConcreteCostItem a rdfs:Class ; rdfs:subClassOf rcpp:CostItem ; rdfs:label "콘크리트 비용항목"@ko ; rdfs:comment "레미콘 재료와 콘크리트 타설 단가를 구분하는 비용항목"@ko .
rcpp:ReadyMixedConcreteMaterialCostItem a rdfs:Class ; rdfs:subClassOf rcpp:ConcreteCostItem ; rdfs:label "레디믹스트콘크리트 재료비항목"@ko ; rdfs:comment "골재크기·강도·슬럼프로 구분하는 레디믹스트콘크리트 재료 단가 항목"@ko .
rcpp:ConcretePlacementCostItem a rdfs:Class ; rdfs:subClassOf rcpp:ConcreteCostItem ; rdfs:label "콘크리트 타설비항목"@ko ; rdfs:comment "타설방법과 구조물 유형으로 구분하는 콘크리트 시공 단가 항목"@ko .
rcpp:FormworkCostItem a rdfs:Class ; rdfs:subClassOf rcpp:CostItem ; rdfs:label "거푸집 비용항목"@ko ; rdfs:comment "거푸집 설치·해체 단가를 구분하는 비용항목"@ko .
rcpp:ShoringCostItem a rdfs:Class ; rdfs:subClassOf rcpp:CostItem ; rdfs:label "동바리 비용항목"@ko ; rdfs:comment "동바리 설치·해체 단가를 구분하는 비용항목"@ko .
rcpp:Unit a rdfs:Class ; rdfs:label "단위"@ko ; rdfs:comment "비용항목 수량을 측정하는 단위"@ko .

# -----------------------------------------------------------------------------
# properties.ttl
# -----------------------------------------------------------------------------
@prefix rcpp: <https://zioni715.github.io/ontology/rcpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# 문서 구조와 의미 흐름 관계
rcpp:belongsToProgressRound a rdf:Property ; rdfs:label "기성회차 소속"@ko ; rdfs:comment "공사기성부분내역서가 적용되는 기성회차"@ko ; rdfs:domain rcpp:ProgressPaymentStatement ; rdfs:range rcpp:ProgressPaymentRound .
rcpp:containsItem a rdf:Property ; rdfs:label "항목 포함"@ko ; rdfs:comment "기성서류가 포함하는 비용정보 항목"@ko ; rdfs:domain rcpp:ProgressDocument ; rdfs:range rcpp:DocumentItem .
rcpp:representsCostItem a rdf:Property ; rdfs:label "비용항목 표현"@ko ; rdfs:comment "서류항목이 의미하는 표준 비용항목"@ko ; rdfs:domain rcpp:DocumentItem ; rdfs:range rcpp:CostItem .
rcpp:contributesContractAmountTo a rdf:Property ; rdfs:label "계약금액 → 공종별 계약집계"@ko ; rdfs:comment "공종별내역항목의 계약금액을 계약집계항목으로 합산"@ko ; rdfs:domain rcpp:WorkCategoryDetailItem ; rdfs:range rcpp:ContractSummaryItem ; rcpp:validationStatus "confirmed" .
rcpp:contributesCurrentAmountTo a rdf:Property ; rdfs:label "금회금액 → 공종별 기성집계"@ko ; rdfs:comment "기성내역항목의 금회금액을 기성집계항목으로 합산"@ko ; rdfs:domain rcpp:ProgressPaymentItem ; rdfs:range rcpp:ProgressPaymentSummaryItem ; rcpp:validationStatus "confirmed" .
rcpp:belongsToWorkCategory a rdf:Property ; rdfs:label "공종 소속"@ko ; rdfs:comment "비용항목 또는 집계항목을 철근·콘크리트·거푸집·동바리 중 하나로 분류"@ko ; rdfs:range rcpp:WorkCategory .
rcpp:subWorkCategoryOf a rdf:Property ; rdfs:label "상위 공종"@ko ; rdfs:comment "세부 공종이 속하는 상위 공종"@ko ; rdfs:domain rcpp:WorkCategory ; rdfs:range rcpp:WorkCategory .
rcpp:usesUnit a rdf:Property ; rdfs:label "단위 사용"@ko ; rdfs:comment "비용 수량에 적용되는 측정 단위"@ko ; rdfs:domain rcpp:DetailItem ; rdfs:range rcpp:Unit .
rcpp:previousProgressRound a rdf:Property ; rdfs:label "이전 기성회차"@ko ; rdfs:comment "현재 회차가 이월값을 참조하는 직전 회차"@ko ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range rcpp:ProgressPaymentRound .

# 서류 간 비용정보의 명시적 전달 흐름
rcpp:providesCalculatedQuantityTo a rdf:Property ; rdfs:label "산출수량 → 계약수량"@ko ; rdfs:comment "수량산출항목의 calculatedQuantity를 계약항목의 contractQuantity 근거로 전달"@ko ; rdfs:domain rcpp:CalculatedQuantityItem ; rdfs:range rcpp:ContractItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractValueTo a rdf:Property ; rdfs:label "계약값 전달"@ko ; rdfs:comment "계약항목의 수량·단가·금액을 공종별내역항목으로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:WorkCategoryDetailItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractQuantityTo a rdf:Property ; rdfs:subPropertyOf rcpp:providesContractValueTo ; rdfs:label "계약수량 → 공종별내역 계약수량"@ko ; rdfs:comment "계약항목의 contractQuantity를 공종별내역항목의 contractQuantity로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:WorkCategoryDetailItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractUnitPriceTo a rdf:Property ; rdfs:subPropertyOf rcpp:providesContractValueTo ; rdfs:label "계약단가 → 공종별내역 계약단가"@ko ; rdfs:comment "계약항목의 contractUnitPrice를 공종별내역항목의 contractUnitPrice로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:WorkCategoryDetailItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractAmountTo a rdf:Property ; rdfs:subPropertyOf rcpp:providesContractValueTo ; rdfs:label "계약금액 → 공종별내역 계약금액"@ko ; rdfs:comment "계약항목의 contractAmount를 공종별내역항목의 contractAmount로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:WorkCategoryDetailItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractUnitPriceToProgressPaymentItem a rdf:Property ; rdfs:label "계약단가 → 기성내역 계약단가"@ko ; rdfs:comment "계약항목의 contractUnitPrice를 기성내역항목의 contractUnitPrice로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:ProgressPaymentItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractQuantityToProgressPaymentItem a rdf:Property ; rdfs:label "계약수량 → 기성내역 계약수량"@ko ; rdfs:comment "계약항목의 contractQuantity를 기성내역항목의 contractQuantity로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:ProgressPaymentItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractAmountToProgressPaymentItem a rdf:Property ; rdfs:label "계약금액 → 기성내역 계약금액"@ko ; rdfs:comment "계약항목의 contractAmount를 기성내역항목의 contractAmount로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:ProgressPaymentItem ; rcpp:validationStatus "confirmed" .
rcpp:providesCumulativeValuesTo a rdf:Property ; rdfs:label "이전 누계 → 현재 전회값"@ko ; rdfs:comment "이전 기성내역항목의 누계수량·누계금액을 현재 기성내역항목의 전회누계값으로 전달"@ko ; rdfs:domain rcpp:ProgressPaymentItem ; rdfs:range rcpp:ProgressPaymentItem ; rcpp:validationStatus "confirmed" .

# 공통 식별정보
rcpp:validationStatus a rdf:Property ; rdfs:label "검증 상태"@ko ; rdfs:comment "관계 또는 규칙의 확정 여부를 confirmed 또는 provisional로 표시"@ko ; rdfs:range xsd:string .
rcpp:roundNumber a rdf:Property ; rdfs:label "회차 번호"@ko ; rdfs:comment "기성회차의 순번"@ko ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range xsd:integer .
rcpp:documentIdentifier a rdf:Property ; rdfs:label "서류 식별자"@ko ; rdfs:comment "업무에서 서류를 식별하는 문자열"@ko ; rdfs:domain rcpp:ProgressDocument ; rdfs:range xsd:string .
rcpp:itemCode a rdf:Property ; rdfs:label "항목 코드"@ko ; rdfs:comment "비용항목의 식별 코드"@ko ; rdfs:domain rcpp:CostItem ; rdfs:range xsd:string .
rcpp:itemName a rdf:Property ; rdfs:label "항목명"@ko ; rdfs:comment "서류항목과 비용항목에서 공통으로 사용하는 품명"@ko ; rdfs:range xsd:string .
rcpp:specification a rdf:Property ; rdfs:label "규격"@ko ; rdfs:comment "공종 다음에 비용항목을 구분하는 규격 문자열"@ko ; rdfs:domain rcpp:CostItem ; rdfs:range xsd:string .

# 비용규격의 구조화된 리터럴 값
rcpp:rebarGrade a rdf:Property ; rdfs:label "철근 강종"@ko ; rdfs:comment "철근 비용항목을 구분하는 강종"@ko ; rdfs:domain rcpp:RebarCostItem ; rdfs:range xsd:string .
rcpp:nominalDiameterMm a rdf:Property ; rdfs:label "호칭지름(mm)"@ko ; rdfs:comment "철근 규격의 호칭지름 수치"@ko ; rdfs:domain rcpp:RebarCostItem ; rdfs:range xsd:decimal .
rcpp:fabricationAssemblyType a rdf:Property ; rdfs:label "가공·조립 유형"@ko ; rdfs:comment "철근 가공·조립 품을 구분하는 작업 유형"@ko ; rdfs:domain rcpp:RebarFabricationAssemblyCostItem ; rdfs:range xsd:string .
rcpp:processingLocation a rdf:Property ; rdfs:label "가공 장소"@ko ; rdfs:comment "현장가공 또는 공장가공 구분"@ko ; rdfs:domain rcpp:RebarFabricationAssemblyCostItem ; rdfs:range xsd:string .
rcpp:maximumAggregateSizeMm a rdf:Property ; rdfs:label "굵은골재 최대치수(mm)"@ko ; rdfs:comment "레미콘 규격의 굵은골재 최대치수"@ko ; rdfs:domain rcpp:ReadyMixedConcreteMaterialCostItem ; rdfs:range xsd:decimal .
rcpp:nominalStrengthMPa a rdf:Property ; rdfs:label "호칭강도(MPa)"@ko ; rdfs:comment "레미콘 규격의 호칭강도"@ko ; rdfs:domain rcpp:ReadyMixedConcreteMaterialCostItem ; rdfs:range xsd:decimal .
rcpp:slumpMm a rdf:Property ; rdfs:label "슬럼프(mm)"@ko ; rdfs:comment "레미콘 규격의 슬럼프"@ko ; rdfs:domain rcpp:ReadyMixedConcreteMaterialCostItem ; rdfs:range xsd:decimal .
rcpp:placementMethod a rdf:Property ; rdfs:label "타설방법"@ko ; rdfs:comment "콘크리트 타설비를 구분하는 장비 또는 시공방법"@ko ; rdfs:domain rcpp:ConcretePlacementCostItem ; rdfs:range xsd:string .
rcpp:structureType a rdf:Property ; rdfs:label "구조물 유형"@ko ; rdfs:comment "콘크리트 타설비를 구분하는 구조물 유형"@ko ; rdfs:domain rcpp:ConcretePlacementCostItem ; rdfs:range xsd:string .
rcpp:formworkType a rdf:Property ; rdfs:label "거푸집 종류"@ko ; rdfs:comment "거푸집 비용을 구분하는 형식 또는 재료"@ko ; rdfs:domain rcpp:FormworkCostItem ; rdfs:range xsd:string .
rcpp:reuseCount a rdf:Property ; rdfs:label "전용횟수"@ko ; rdfs:comment "거푸집 비용을 구분하는 전용횟수"@ko ; rdfs:domain rcpp:FormworkCostItem ; rdfs:range xsd:integer .
rcpp:complexityClass a rdf:Property ; rdfs:label "복잡도 구분"@ko ; rdfs:comment "거푸집 품을 구분하는 작업 복잡도"@ko ; rdfs:domain rcpp:FormworkCostItem ; rdfs:range xsd:string .
rcpp:applicationPart a rdf:Property ; rdfs:label "적용부위"@ko ; rdfs:comment "거푸집 비용항목의 구조 적용부위"@ko ; rdfs:domain rcpp:FormworkCostItem ; rdfs:range xsd:string .
rcpp:shoringType a rdf:Property ; rdfs:label "동바리 종류"@ko ; rdfs:comment "동바리 비용을 구분하는 형식"@ko ; rdfs:domain rcpp:ShoringCostItem ; rdfs:range xsd:string .
rcpp:maximumInstallationHeightM a rdf:Property ; rdfs:label "최대 설치높이(m)"@ko ; rdfs:comment "동바리 비용을 구분하는 최대 설치높이 수치"@ko ; rdfs:domain rcpp:ShoringCostItem ; rdfs:range xsd:decimal .
rcpp:quantityBasis a rdf:Property ; rdfs:label "수량산정 기준"@ko ; rdfs:comment "면적 또는 공간체적으로 한정한 동바리 수량산정 기준"@ko ; rdfs:domain rcpp:ShoringCostItem ; rdfs:range xsd:string .

# 상세 속성의 근거 추적
rcpp:rebarGrade dcterms:source rcpp:KCSRebarReference, rcpp:StandardEstimatingReference .
rcpp:nominalDiameterMm dcterms:source rcpp:KCSRebarReference, rcpp:StandardEstimatingReference .
rcpp:fabricationAssemblyType dcterms:source rcpp:StandardEstimatingReference .
rcpp:processingLocation dcterms:source rcpp:StandardEstimatingReference .
rcpp:maximumAggregateSizeMm dcterms:source rcpp:KSF4009Reference .
rcpp:nominalStrengthMPa dcterms:source rcpp:KSF4009Reference .
rcpp:slumpMm dcterms:source rcpp:KSF4009Reference .
rcpp:placementMethod dcterms:source rcpp:StandardEstimatingReference .
rcpp:structureType dcterms:source rcpp:StandardEstimatingReference .
rcpp:formworkType dcterms:source rcpp:KCSFormworkShoringReference, rcpp:StandardEstimatingReference .
rcpp:reuseCount dcterms:source rcpp:StandardEstimatingReference .
rcpp:complexityClass dcterms:source rcpp:StandardEstimatingReference .
rcpp:applicationPart dcterms:source rcpp:KCSFormworkShoringReference .
rcpp:shoringType dcterms:source rcpp:KCSFormworkShoringReference, rcpp:StandardEstimatingReference .
rcpp:maximumInstallationHeightM dcterms:source rcpp:KCSFormworkShoringReference, rcpp:StandardEstimatingReference .
rcpp:quantityBasis dcterms:source rcpp:StandardEstimatingReference .

# 수량·단가·금액
rcpp:contractQuantity a rdf:Property ; rdfs:label "계약수량"@ko ; rdfs:comment "계약내역서에 확정된 수량"@ko ; rdfs:range xsd:decimal .
rcpp:calculatedQuantity a rdf:Property ; rdfs:label "산출수량"@ko ; rdfs:comment "수량산출서에서 계산된 계약수량 근거값"@ko ; rdfs:range xsd:decimal .
rcpp:previousCumulativeQuantity a rdf:Property ; rdfs:label "전회누계수량"@ko ; rdfs:comment "직전 회차까지 인정된 누계수량"@ko ; rdfs:range xsd:decimal .
rcpp:currentQuantity a rdf:Property ; rdfs:label "금회수량"@ko ; rdfs:comment "기성내역 한 행에서 현재 회차에 인정된 수량"@ko ; rdfs:domain rcpp:ProgressPaymentItem ; rdfs:range xsd:decimal .
rcpp:cumulativeQuantity a rdf:Property ; rdfs:label "누계수량"@ko ; rdfs:comment "전회누계수량과 금회수량의 합"@ko ; rdfs:range xsd:decimal .
rcpp:remainingQuantity a rdf:Property ; rdfs:label "잔여수량"@ko ; rdfs:comment "계약수량에서 누계수량을 뺀 값"@ko ; rdfs:range xsd:decimal .
rcpp:contractUnitPrice a rdf:Property ; rdfs:label "계약단가"@ko ; rdfs:comment "계약내역서에 확정된 단가"@ko ; rdfs:range xsd:decimal .
rcpp:contractAmount a rdf:Property ; rdfs:label "계약금액"@ko ; rdfs:comment "계약내역서에 확정된 금액"@ko ; rdfs:range xsd:decimal .
rcpp:previousCumulativeAmount a rdf:Property ; rdfs:label "전회누계금액"@ko ; rdfs:comment "직전 회차까지 인정된 누계금액"@ko ; rdfs:range xsd:decimal .
rcpp:currentAmount a rdf:Property ; rdfs:label "금회금액"@ko ; rdfs:comment "현재 기성회차에서 인정되며 누계기성금액 산정에 반영되는 금액"@ko ; rdfs:range xsd:decimal .
rcpp:cumulativeAmount a rdf:Property ; rdfs:label "누계금액"@ko ; rdfs:comment "전회누계금액과 금회금액의 합"@ko ; rdfs:range xsd:decimal .
rcpp:remainingAmount a rdf:Property ; rdfs:label "잔여금액"@ko ; rdfs:comment "계약금액에서 누계금액을 뺀 값"@ko ; rdfs:range xsd:decimal .

rcpp:materialUnitCost a rdf:Property ; rdfs:label "단위당 재료비"@ko ; rdfs:comment "비용항목 한 단위당 재료비"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range xsd:decimal .
rcpp:laborUnitCost a rdf:Property ; rdfs:label "단위당 노무비"@ko ; rdfs:comment "비용항목 한 단위당 노무비"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range xsd:decimal .
rcpp:expenseUnitCost a rdf:Property ; rdfs:label "단위당 경비"@ko ; rdfs:comment "비용항목 한 단위당 경비"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range xsd:decimal .
rcpp:calculatedUnitPrice a rdf:Property ; rdfs:label "산출단가"@ko ; rdfs:comment "단위당 재료비·노무비·경비 합계로 산출된 단가"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range xsd:decimal .

