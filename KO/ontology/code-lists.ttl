@prefix rcpp: <https://example.org/rcpp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# 공종은 클래스와 개체를 혼용하지 않는 통제 분류 개체로 정의한다.
rcpp:ReinforcedConcreteWork a rcpp:WorkCategory ; rdfs:label "철근콘크리트공사"@ko ; rdfs:comment "본 온톨로지가 다루는 최상위 공종"@ko .
rcpp:RebarWork a rcpp:WorkCategory ; rcpp:subWorkCategoryOf rcpp:ReinforcedConcreteWork ; rdfs:label "철근공사"@ko ; rdfs:comment "철근 재료와 가공·조립 비용 공종"@ko .
rcpp:ConcreteWork a rcpp:WorkCategory ; rcpp:subWorkCategoryOf rcpp:ReinforcedConcreteWork ; rdfs:label "콘크리트공사"@ko ; rdfs:comment "레미콘 재료와 콘크리트 타설 비용 공종"@ko .
rcpp:FormworkWork a rcpp:WorkCategory ; rcpp:subWorkCategoryOf rcpp:ReinforcedConcreteWork ; rdfs:label "거푸집공사"@ko ; rdfs:comment "거푸집 설치·해체 비용 공종"@ko .
rcpp:ShoringWork a rcpp:WorkCategory ; rcpp:subWorkCategoryOf rcpp:ReinforcedConcreteWork ; rdfs:label "동바리공사"@ko ; rdfs:comment "동바리 설치·해체 비용 공종"@ko .

rcpp:Tonne a rcpp:Unit ; rdfs:label "톤"@ko ; rdfs:comment "철근 수량에 사용하는 질량 단위 t"@ko .
rcpp:CubicMetre a rcpp:Unit ; rdfs:label "세제곱미터"@ko ; rdfs:comment "콘크리트 수량에 사용하는 체적 단위 m³"@ko .
rcpp:SquareMetre a rcpp:Unit ; rdfs:label "제곱미터"@ko ; rdfs:comment "거푸집과 동바리 수량에 사용하는 면적 단위 m²"@ko .
rcpp:CubicMetreSpace a rcpp:Unit ; rdfs:label "공간세제곱미터"@ko ; rdfs:comment "시스템동바리 수량산정에 사용하는 공간체적 단위 공m³"@ko .

