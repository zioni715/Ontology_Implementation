ex:PQ3-R10 a rcpp:CurrentProgressQuantityItem ; rcpp:itemName "철근 D10 3회 수량" ; rcpp:representsCostItem ex:RebarD10 ; rcpp:usesUnit rcpp:Tonne ; rcpp:currentQuantity 5.0.
ex:PR-R10 a rcpp:ProgressItem ; rdfs:label "철근 D10 3회 기성"@ko ; rcpp:itemName "철근 D10 3회 기성" ; rcpp:representsCostItem ex:RebarD10 ; rcpp:usesUnit rcpp:Tonne ; rcpp:contractQuantity 50.0 ; rcpp:contractUnitPrice 1000.0 ; rcpp:contractAmount 50000.0 ; rcpp:previousQuantity 10.0 ; rcpp:currentQuantity 5.0 ; rcpp:cumulativeQuantity 15.0 ; rcpp:remainingQuantity 35.0 ; rcpp:previousAmount 10000.0 ; rcpp:currentAmount 5000.0 ; rcpp:cumulativeAmount 15000.0 ; rcpp:remainingAmount 35000.0; rcpp:aggregatedProgressInto ex:PS-R .

