@prefix rcpp: <https://example.org/rcpp#> .
@prefix ex: <https://example.org/rcpp/example#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Round1 a rcpp:ProgressPaymentRound ; rcpp:roundNumber 1 .
ex:Round2 a rcpp:ProgressPaymentRound ; rcpp:roundNumber 2 ; rcpp:previousProgressRound ex:Round1 .
ex:Round3 a rcpp:ProgressPaymentRound ; rcpp:roundNumber 3 ; rcpp:previousProgressRound ex:Round2 .
ex:QuantityDoc a rcpp:QuantityCalculationSheet ; rcpp:documentIdentifier "QTY-A" .
ex:ContractDoc a rcpp:ContractStatement ; rcpp:documentIdentifier "CON-A" .
ex:CostDoc a rcpp:CostCalculationStatement ; rcpp:documentIdentifier "COST-A" .
ex:DetailDoc a rcpp:WorkTypeDetailStatement ; rcpp:documentIdentifier "DET-A" .
ex:ContractSummaryDoc a rcpp:WorkTypeSummaryStatement ; rcpp:documentIdentifier "SUM-A" .
ex:PaymentDocR2 a rcpp:ProgressPaymentStatement ; rcpp:documentIdentifier "PAY-R2" ; rcpp:belongsToProgressRound ex:Round2 .
ex:PaymentDocR3 a rcpp:ProgressPaymentStatement ; rcpp:documentIdentifier "PAY-R3" ; rcpp:belongsToProgressRound ex:Round3 .

ex:RebarD10 a rcpp:RebarFabricationAssemblyCostItem ; rcpp:itemCode "R-10" ; rcpp:itemName "철근가공조립 D10" ; rcpp:specification "SD400 D10 현장 가공·조립" ; rcpp:belongsToWorkCategory rcpp:RebarWork ; rcpp:rebarGrade "SD400" ; rcpp:nominalDiameterMm 10.0 ; rcpp:fabricationAssemblyType "가공·조립" ; rcpp:processingLocation "현장가공" .
