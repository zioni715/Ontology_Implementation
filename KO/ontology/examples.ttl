# 원가계산서는 공종별내역서에 비용 산정 근거를 전달한다.
ex:CI-R10 a rcpp:CostCalculationItem ; rcpp:itemName "철근 D10 원가계산" ; rcpp:representsCostItem ex:RebarD10 ; rcpp:usesUnit rcpp:Tonne ; rcpp:materialUnitCost 600.0 ; rcpp:laborUnitCost 300.0 ; rcpp:expenseUnitCost 100.0 ; rcpp:calculatedUnitPrice 1000.0 .
ex:CI-R16 a rcpp:CostCalculationItem ; rcpp:itemName "철근 D16 원가계산" ; rcpp:representsCostItem ex:RebarD16 ; rcpp:usesUnit rcpp:Tonne ; rcpp:materialUnitCost 600.0 ; rcpp:laborUnitCost 300.0 ; rcpp:expenseUnitCost 100.0 ; rcpp:calculatedUnitPrice 1000.0 .
