# 일반 대응 관계와 함께, 서류 간 전달 의미를 명시적으로 기록한다.
ex:QB-R10 rcpp:providesCalculatedQuantityTo ex:CT-R10 .
ex:QB-R16 rcpp:providesCalculatedQuantityTo ex:CT-R16 .
ex:QB-R16-2 rcpp:providesCalculatedQuantityTo ex:CT-R16 .
ex:QB-C rcpp:providesCalculatedQuantityTo ex:CT-C .
ex:QB-F rcpp:providesCalculatedQuantityTo ex:CT-F .
ex:QB-S rcpp:providesCalculatedQuantityTo ex:CT-S .
ex:CT-R10 rcpp:providesContractQuantityTo ex:WD-R10 ; rcpp:providesContractUnitPriceTo ex:WD-R10 ; rcpp:providesContractAmountTo ex:WD-R10 ; rcpp:providesContractQuantityToProgress ex:PV-R10, ex:PR-R10 ; rcpp:providesContractUnitPriceToProgress ex:PV-R10, ex:PR-R10 ; rcpp:providesContractAmountToProgress ex:PV-R10, ex:PR-R10 .
ex:CT-R16 rcpp:providesContractQuantityTo ex:WD-R16 ; rcpp:providesContractUnitPriceTo ex:WD-R16 ; rcpp:providesContractAmountTo ex:WD-R16 ; rcpp:providesContractQuantityToProgress ex:PV-R16, ex:PR-R16 ; rcpp:providesContractUnitPriceToProgress ex:PV-R16, ex:PR-R16 ; rcpp:providesContractAmountToProgress ex:PV-R16, ex:PR-R16 .
ex:CT-C rcpp:providesContractQuantityTo ex:WD-C ; rcpp:providesContractUnitPriceTo ex:WD-C ; rcpp:providesContractAmountTo ex:WD-C ; rcpp:providesContractQuantityToProgress ex:PV-C, ex:PR-C ; rcpp:providesContractUnitPriceToProgress ex:PV-C, ex:PR-C ; rcpp:providesContractAmountToProgress ex:PV-C, ex:PR-C .
ex:CT-F rcpp:providesContractQuantityTo ex:WD-F ; rcpp:providesContractUnitPriceTo ex:WD-F ; rcpp:providesContractAmountTo ex:WD-F ; rcpp:providesContractQuantityToProgress ex:PV-F, ex:PR-F ; rcpp:providesContractUnitPriceToProgress ex:PV-F, ex:PR-F ; rcpp:providesContractAmountToProgress ex:PV-F, ex:PR-F .
ex:CT-S rcpp:providesContractQuantityTo ex:WD-S ; rcpp:providesContractUnitPriceTo ex:WD-S ; rcpp:providesContractAmountTo ex:WD-S ; rcpp:providesContractQuantityToProgress ex:PV-S, ex:PR-S ; rcpp:providesContractUnitPriceToProgress ex:PV-S, ex:PR-S ; rcpp:providesContractAmountToProgress ex:PV-S, ex:PR-S .
