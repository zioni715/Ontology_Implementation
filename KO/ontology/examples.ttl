ex:RebarMaterialD10 a rcpp:RebarMaterialCostItem ; rcpp:itemCode "RM-10" ; rcpp:itemName "철근재료 D10" ; rcpp:specification "SD400 D10" ; rcpp:belongsToWorkCategory rcpp:RebarWork ; rcpp:rebarGrade "SD400" ; rcpp:nominalDiameterMm 10.0 .
ex:Concrete a rcpp:ConcretePlacementCostItem ; rcpp:itemCode "C-01" ; rcpp:itemName "콘크리트 펌프카 타설" ; rcpp:specification "펌프카 일반구조물" ; rcpp:belongsToWorkCategory rcpp:ConcreteWork ; rcpp:placementMethod "펌프카" ; rcpp:structureType "일반구조물" .
ex:ReadyMixedConcrete a rcpp:ReadyMixedConcreteCostItem ; rcpp:itemCode "CM-01" ; rcpp:itemName "레디믹스트콘크리트" ; rcpp:specification "25-24-150" ; rcpp:belongsToWorkCategory rcpp:ConcreteWork ; rcpp:maximumAggregateSizeMm 25.0 ; rcpp:nominalStrengthMPa 24.0 ; rcpp:slumpMm 150.0 .
ex:Formwork a rcpp:FormworkCostItem ; rcpp:itemCode "F-01" ; rcpp:itemName "합판거푸집" ; rcpp:specification "3회 보통" ; rcpp:belongsToWorkCategory rcpp:FormworkWork ; rcpp:formworkType "합판거푸집" ; rcpp:reuseCount 3 ; rcpp:complexityClass "보통" ; rcpp:applicationPart "벽", "기둥", "보", "슬래브" .
