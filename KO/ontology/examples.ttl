ex:CI-F a rcpp:CostCalculationItem ; rcpp:itemName "거푸집 원가계산" ; rcpp:representsCostItem ex:Formwork ; rcpp:usesUnit rcpp:SquareMetre ; rcpp:materialUnitCost 80.0 ; rcpp:laborUnitCost 100.0 ; rcpp:expenseUnitCost 20.0 ; rcpp:calculatedUnitPrice 200.0 .
ex:CI-S a rcpp:CostCalculationItem ; rcpp:itemName "동바리 원가계산" ; rcpp:representsCostItem ex:Shoring ; rcpp:usesUnit rcpp:CubicMetreSpace ; rcpp:materialUnitCost 40.0 ; rcpp:laborUnitCost 50.0 ; rcpp:expenseUnitCost 10.0 ; rcpp:calculatedUnitPrice 100.0 .

