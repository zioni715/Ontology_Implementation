@prefix rcpp: <https://example.org/rcpp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# 문서 구조와 의미 흐름 관계
rcpp:belongsToProgressRound a rdf:Property ; rdfs:label "기성회차 소속"@ko ; rdfs:comment "공사기성부분내역서가 적용되는 기성회차"@ko ; rdfs:domain rcpp:ProgressPaymentStatement ; rdfs:range rcpp:ProgressPaymentRound .
rcpp:containsItem a rdf:Property ; rdfs:label "항목 포함"@ko ; rdfs:comment "기성서류가 포함하는 비용정보 항목"@ko ; rdfs:domain rcpp:ProgressDocument ; rdfs:range rcpp:DocumentItem .
rcpp:representsCostItem a rdf:Property ; rdfs:label "비용항목 표현"@ko ; rdfs:comment "서류항목이 의미하는 표준 비용항목"@ko ; rdfs:domain rcpp:DocumentItem ; rdfs:range rcpp:CostItem .
rcpp:aggregatedContractInto a rdf:Property ; rdfs:label "계약금액 집계"@ko ; rdfs:comment "공종별내역항목의 계약금액을 계약집계항목으로 합산"@ko ; rdfs:domain rcpp:WorkTypeDetailItem ; rdfs:range rcpp:ContractSummaryItem ; rcpp:validationStatus "confirmed" .
rcpp:aggregatedProgressInto a rdf:Property ; rdfs:label "기성금액 집계"@ko ; rdfs:comment "기성금액항목의 금회금액을 기성집계항목으로 합산"@ko ; rdfs:domain rcpp:ProgressItem ; rdfs:range rcpp:ProgressSummaryItem ; rcpp:validationStatus "confirmed" .
rcpp:belongsToWorkCategory a rdf:Property ; rdfs:label "철근콘크리트 공종"@ko ; rdfs:comment "비용항목 또는 집계항목을 철근·콘크리트·거푸집·동바리 중 하나로 분류"@ko ; rdfs:range rcpp:WorkCategory .
rcpp:subWorkCategoryOf a rdf:Property ; rdfs:label "상위 공종"@ko ; rdfs:comment "세부 공종이 속하는 상위 공종"@ko ; rdfs:domain rcpp:WorkCategory ; rdfs:range rcpp:WorkCategory .
rcpp:usesUnit a rdf:Property ; rdfs:label "단위 사용"@ko ; rdfs:comment "비용 수량에 적용되는 측정 단위"@ko ; rdfs:domain rcpp:DetailItem ; rdfs:range rcpp:Unit .
rcpp:previousProgressRound a rdf:Property ; rdfs:label "이전 기성회차"@ko ; rdfs:comment "현재 회차가 이월값을 참조하는 직전 회차"@ko ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range rcpp:ProgressPaymentRound .

# 서류 간 비용정보의 명시적 전달 흐름
rcpp:providesCalculatedQuantityTo a rdf:Property ; rdfs:label "산출수량 → 계약수량"@ko ; rdfs:comment "수량산출항목의 calculatedQuantity를 계약항목의 contractQuantity 근거로 전달"@ko ; rdfs:domain rcpp:CalculatedQuantityItem ; rdfs:range rcpp:ContractItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractValueTo a rdf:Property ; rdfs:label "계약값 전달"@ko ; rdfs:comment "계약항목의 수량·단가·금액을 공종별내역항목으로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:WorkTypeDetailItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractQuantityTo a rdf:Property ; rdfs:subPropertyOf rcpp:providesContractValueTo ; rdfs:label "계약수량 → 계약수량"@ko ; rdfs:comment "계약항목의 contractQuantity를 공종별내역항목의 contractQuantity로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:WorkTypeDetailItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractUnitPriceTo a rdf:Property ; rdfs:subPropertyOf rcpp:providesContractValueTo ; rdfs:label "계약단가 → 계약단가"@ko ; rdfs:comment "계약항목의 contractUnitPrice를 공종별내역항목의 contractUnitPrice로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:WorkTypeDetailItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractAmountTo a rdf:Property ; rdfs:subPropertyOf rcpp:providesContractValueTo ; rdfs:label "계약금액 → 계약금액"@ko ; rdfs:comment "계약항목의 contractAmount를 공종별내역항목의 contractAmount로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:WorkTypeDetailItem ; rcpp:validationStatus "confirmed" .
rcpp:providesCostBasisTo a rdf:Property ; rdfs:label "원가산정 근거 제공(속성 매핑 미확정)"@ko ; rdfs:comment "원가계산항목이 공종별내역항목에 산정 근거를 제공하지만 전달 속성 매핑과 업무기준 출처는 미확정"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range rcpp:WorkTypeDetailItem ; rcpp:validationStatus "provisional" .
rcpp:providesCurrentQuantityTo a rdf:Property ; rdfs:label "금회수량 → 금회수량"@ko ; rdfs:comment "확정수량항목의 currentQuantity를 기성금액항목의 currentQuantity로 전달"@ko ; rdfs:domain rcpp:CurrentProgressQuantityItem ; rdfs:range rcpp:ProgressItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractUnitPriceToProgress a rdf:Property ; rdfs:label "계약단가 → 기성 계약단가"@ko ; rdfs:comment "계약항목의 contractUnitPrice를 기성금액항목의 contractUnitPrice로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:ProgressItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractQuantityToProgress a rdf:Property ; rdfs:label "계약수량 → 계약수량"@ko ; rdfs:comment "계약항목의 contractQuantity를 기성금액항목의 contractQuantity로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:ProgressItem ; rcpp:validationStatus "confirmed" .
rcpp:providesContractAmountToProgress a rdf:Property ; rdfs:label "계약금액 → 계약금액"@ko ; rdfs:comment "계약항목의 contractAmount를 기성금액항목의 contractAmount로 전달"@ko ; rdfs:domain rcpp:ContractItem ; rdfs:range rcpp:ProgressItem ; rcpp:validationStatus "confirmed" .
rcpp:providesPreviousTotalTo a rdf:Property ; rdfs:label "전회누계 전달"@ko ; rdfs:comment "이전 기성항목의 누계수량·누계금액을 현재 기성금액항목으로 전달"@ko ; rdfs:domain rcpp:ProgressItem ; rdfs:range rcpp:ProgressItem ; rcpp:validationStatus "confirmed" .

# 공통 식별정보
rcpp:validationStatus a rdf:Property ; rdfs:label "검증 상태"@ko ; rdfs:comment "관계 또는 규칙의 확정 여부를 confirmed 또는 provisional로 표시"@ko ; rdfs:range xsd:string .
rcpp:roundNumber a rdf:Property ; rdfs:label "회차 번호"@ko ; rdfs:comment "기성회차의 순번"@ko ; rdfs:domain rcpp:ProgressPaymentRound ; rdfs:range xsd:integer .
rcpp:documentIdentifier a rdf:Property ; rdfs:label "서류 식별자"@ko ; rdfs:comment "업무에서 서류를 식별하는 문자열"@ko ; rdfs:domain rcpp:ProgressDocument ; rdfs:range xsd:string .
rcpp:itemCode a rdf:Property ; rdfs:label "항목 코드"@ko ; rdfs:comment "비용항목의 식별 코드"@ko ; rdfs:domain rcpp:CostItem ; rdfs:range xsd:string .
rcpp:itemName a rdf:Property ; rdfs:label "항목명"@ko ; rdfs:comment "서류항목과 비용항목에서 공통으로 사용하는 품명"@ko ; rdfs:range xsd:string .
rcpp:specification a rdf:Property ; rdfs:label "규격"@ko ; rdfs:comment "공종 다음에 비용항목을 구분하는 규격 문자열"@ko ; rdfs:domain rcpp:CostItem ; rdfs:range xsd:string .

# 비용규격의 구조화된 리터럴 값
rcpp:rebarGrade a rdf:Property ; rdfs:label "철근 강종"@ko ; rdfs:comment "철근 재료비를 구분하는 강종"@ko ; rdfs:domain rcpp:RebarCostItem ; rdfs:range xsd:string .
rcpp:nominalDiameterMm a rdf:Property ; rdfs:label "호칭지름(mm)"@ko ; rdfs:comment "철근 규격의 호칭지름 수치"@ko ; rdfs:domain rcpp:RebarCostItem ; rdfs:range xsd:decimal .
rcpp:fabricationAssemblyType a rdf:Property ; rdfs:label "가공·조립 유형"@ko ; rdfs:comment "철근 가공·조립 품을 구분하는 작업 유형"@ko ; rdfs:domain rcpp:RebarFabricationAssemblyCostItem ; rdfs:range xsd:string .
rcpp:processingLocation a rdf:Property ; rdfs:label "가공 장소"@ko ; rdfs:comment "현장가공 또는 공장가공 구분"@ko ; rdfs:domain rcpp:RebarFabricationAssemblyCostItem ; rdfs:range xsd:string .
rcpp:maximumAggregateSizeMm a rdf:Property ; rdfs:label "굵은골재 최대치수(mm)"@ko ; rdfs:comment "레미콘 규격의 굵은골재 최대치수"@ko ; rdfs:domain rcpp:ReadyMixedConcreteCostItem ; rdfs:range xsd:decimal .
rcpp:nominalStrengthMPa a rdf:Property ; rdfs:label "호칭강도(MPa)"@ko ; rdfs:comment "레미콘 규격의 호칭강도"@ko ; rdfs:domain rcpp:ReadyMixedConcreteCostItem ; rdfs:range xsd:decimal .
rcpp:slumpMm a rdf:Property ; rdfs:label "슬럼프(mm)"@ko ; rdfs:comment "레미콘 규격의 슬럼프"@ko ; rdfs:domain rcpp:ReadyMixedConcreteCostItem ; rdfs:range xsd:decimal .
rcpp:placementMethod a rdf:Property ; rdfs:label "타설방법"@ko ; rdfs:comment "콘크리트 타설비를 구분하는 장비 또는 시공방법"@ko ; rdfs:domain rcpp:ConcretePlacementCostItem ; rdfs:range xsd:string .
rcpp:structureType a rdf:Property ; rdfs:label "구조물 유형"@ko ; rdfs:comment "콘크리트 타설비를 구분하는 구조물 유형"@ko ; rdfs:domain rcpp:ConcretePlacementCostItem ; rdfs:range xsd:string .
rcpp:formworkType a rdf:Property ; rdfs:label "거푸집 종류"@ko ; rdfs:comment "거푸집 비용을 구분하는 형식 또는 재료"@ko ; rdfs:domain rcpp:FormworkCostItem ; rdfs:range xsd:string .
rcpp:reuseCount a rdf:Property ; rdfs:label "전용횟수"@ko ; rdfs:comment "거푸집 비용을 구분하는 전용횟수"@ko ; rdfs:domain rcpp:FormworkCostItem ; rdfs:range xsd:integer .
rcpp:complexityClass a rdf:Property ; rdfs:label "복잡도 구분"@ko ; rdfs:comment "거푸집 품을 구분하는 작업 복잡도"@ko ; rdfs:domain rcpp:FormworkCostItem ; rdfs:range xsd:string .
rcpp:applicationPart a rdf:Property ; rdfs:label "적용부위"@ko ; rdfs:comment "거푸집 비용항목의 구조 적용부위"@ko ; rdfs:domain rcpp:FormworkCostItem ; rdfs:range xsd:string .
rcpp:shoringType a rdf:Property ; rdfs:label "동바리 종류"@ko ; rdfs:comment "동바리 비용을 구분하는 형식"@ko ; rdfs:domain rcpp:ShoringCostItem ; rdfs:range xsd:string .
rcpp:maximumInstallationHeightM a rdf:Property ; rdfs:label "최대 설치높이(m)"@ko ; rdfs:comment "동바리 비용을 구분하는 최대 설치높이 수치"@ko ; rdfs:domain rcpp:ShoringCostItem ; rdfs:range xsd:decimal .
rcpp:quantityBasis a rdf:Property ; rdfs:label "수량산정 기준"@ko ; rdfs:comment "면적 또는 공간체적으로 한정한 동바리 수량산정 기준"@ko ; rdfs:domain rcpp:ShoringCostItem ; rdfs:range xsd:string .

# 상세 속성의 근거 추적
rcpp:rebarGrade dcterms:source rcpp:KCSRebarReference, rcpp:StandardEstimatingReference .
rcpp:nominalDiameterMm dcterms:source rcpp:KCSRebarReference, rcpp:StandardEstimatingReference .
rcpp:fabricationAssemblyType dcterms:source rcpp:StandardEstimatingReference .
rcpp:processingLocation dcterms:source rcpp:StandardEstimatingReference .
rcpp:maximumAggregateSizeMm dcterms:source rcpp:KSF4009Reference .
rcpp:nominalStrengthMPa dcterms:source rcpp:KSF4009Reference .
rcpp:slumpMm dcterms:source rcpp:KSF4009Reference .
rcpp:placementMethod dcterms:source rcpp:StandardEstimatingReference .
rcpp:structureType dcterms:source rcpp:StandardEstimatingReference .
rcpp:formworkType dcterms:source rcpp:KCSFormworkShoringReference, rcpp:StandardEstimatingReference .
rcpp:reuseCount dcterms:source rcpp:StandardEstimatingReference .
rcpp:complexityClass dcterms:source rcpp:StandardEstimatingReference .
rcpp:applicationPart dcterms:source rcpp:KCSFormworkShoringReference .
rcpp:shoringType dcterms:source rcpp:KCSFormworkShoringReference, rcpp:StandardEstimatingReference .
rcpp:maximumInstallationHeightM dcterms:source rcpp:KCSFormworkShoringReference, rcpp:StandardEstimatingReference .
rcpp:quantityBasis dcterms:source rcpp:StandardEstimatingReference .

# 수량·단가·금액
rcpp:contractQuantity a rdf:Property ; rdfs:label "계약수량"@ko ; rdfs:comment "계약내역서에 확정된 수량"@ko ; rdfs:range xsd:decimal .
rcpp:calculatedQuantity a rdf:Property ; rdfs:label "산출수량"@ko ; rdfs:comment "수량산출서에서 계산된 계약수량 근거값"@ko ; rdfs:range xsd:decimal .
rcpp:previousQuantity a rdf:Property ; rdfs:label "전회수량"@ko ; rdfs:comment "직전 회차까지 인정된 누계수량"@ko ; rdfs:range xsd:decimal .
rcpp:currentQuantity a rdf:Property ; rdfs:label "금회수량"@ko ; rdfs:comment "현재 회차에 인정된 수량"@ko ; rdfs:range xsd:decimal .
rcpp:cumulativeQuantity a rdf:Property ; rdfs:label "누계수량"@ko ; rdfs:comment "전회수량과 금회수량의 합"@ko ; rdfs:range xsd:decimal .
rcpp:remainingQuantity a rdf:Property ; rdfs:label "잔여수량"@ko ; rdfs:comment "계약수량에서 누계수량을 뺀 값"@ko ; rdfs:range xsd:decimal .
rcpp:contractUnitPrice a rdf:Property ; rdfs:label "계약단가"@ko ; rdfs:comment "계약내역서에 확정된 단가"@ko ; rdfs:range xsd:decimal .
rcpp:contractAmount a rdf:Property ; rdfs:label "계약금액"@ko ; rdfs:comment "계약내역서에 확정된 금액"@ko ; rdfs:range xsd:decimal .
rcpp:previousAmount a rdf:Property ; rdfs:label "전회금액"@ko ; rdfs:comment "직전 회차까지 인정된 누계금액"@ko ; rdfs:range xsd:decimal .
rcpp:currentAmount a rdf:Property ; rdfs:label "금회금액"@ko ; rdfs:comment "금회수량과 계약단가로 산정한 금액"@ko ; rdfs:range xsd:decimal .
rcpp:cumulativeAmount a rdf:Property ; rdfs:label "누계금액"@ko ; rdfs:comment "전회금액과 금회금액의 합"@ko ; rdfs:range xsd:decimal .
rcpp:remainingAmount a rdf:Property ; rdfs:label "잔여금액"@ko ; rdfs:comment "계약금액에서 누계금액을 뺀 값"@ko ; rdfs:range xsd:decimal .

rcpp:materialUnitCost a rdf:Property ; rdfs:label "단위당 재료비"@ko ; rdfs:comment "비용항목 한 단위당 재료비"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range xsd:decimal .
rcpp:laborUnitCost a rdf:Property ; rdfs:label "단위당 노무비"@ko ; rdfs:comment "비용항목 한 단위당 노무비"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range xsd:decimal .
rcpp:expenseUnitCost a rdf:Property ; rdfs:label "단위당 경비"@ko ; rdfs:comment "비용항목 한 단위당 경비"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range xsd:decimal .
rcpp:calculatedUnitPrice a rdf:Property ; rdfs:label "산출단가"@ko ; rdfs:comment "단위당 재료비·노무비·경비 합계로 산출된 단가"@ko ; rdfs:domain rcpp:CostCalculationItem ; rdfs:range xsd:decimal .
